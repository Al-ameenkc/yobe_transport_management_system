# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin dashboard password (set your own — visit /admin/login)
ADMIN_PASSWORD=your-secure-admin-password

# Paystack (required for checkout — use sk_test_... locally, sk_live_... in production)
PAYSTACK_SECRET_KEY=

# Resend email (optional — sends ticket to user email on booking)
RESEND_API_KEY=
RESEND_FROM_EMAIL=YOBE LINE <onboarding@resend.dev>

# SMS — Termii (Nigeria) or Twilio (optional — sends ticket number to phone)
TERMII_API_KEY=
TERMII_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI (optional — phase 4)
OPENAI_API_KEY=
